{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotify Widget",
  "version": "0.1.0",
  "identifier": "com.spotify.miniplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spotify Widget",
        "label": "main",
        "width": 92,
        "height": 92,
        "minWidth": 80,
        "minHeight": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "opener": {}
  }
}
